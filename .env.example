# Copy to `.env` in the repo root. Next.js loads `.env` automatically.
#
#   cp .env.example .env
#
# Google AI Studio: https://aistudio.google.com/apikey

GEMINI_API_KEY=

# Optional: exact SDK model id. If unset, API uses gemini-2.5-flash.
# GEMINI_MODEL=

# Shared secret for GET /api/stats (X-Stats-Key header) and the Next.js /stats page (server-side).
# STATS_API_KEY=change-me

# Neon / Postgres — optional. When set, `pnpm build` runs migrations/001_analytics_events.sql, then events + /dashboard work.
# DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require
#
# Optional: cap for the dashboard DB size bar (bytes). Default is 536870912 (0.5 GiB, Neon free).
# ANALYTICS_DB_LIMIT_BYTES=536870912
