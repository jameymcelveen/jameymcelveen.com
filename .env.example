# Copy to `.env` in the repo root. Docker Compose loads `.env` for variable substitution.
#
#   cp .env.example .env
#
# Google AI Studio: https://aistudio.google.com/apikey

GEMINI_API_KEY=

# Optional: exact SDK model id. If unset, API uses Gemini Flash Latest (REST alias gemini-flash-latest).
# GEMINI_MODEL=

# Production API: hide exception details in JSON responses.
# ASPNETCORE_ENVIRONMENT=Production
