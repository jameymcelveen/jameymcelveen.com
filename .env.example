# Copy to `.env` in the repo root. Docker Compose loads `.env` for variable substitution.
#
#   cp .env.example .env
#
# Google AI Studio: https://aistudio.google.com/apikey

GEMINI_API_KEY=

# Optional: exact SDK model id. If unset, API uses Gemini Flash Latest (REST alias gemini-flash-latest).
# GEMINI_MODEL=

# Shared secret for GET /api/stats (X-Stats-Key) and the Next.js /stats page (server-side).
# STATS_API_KEY=change-me

# Where Next.js rewrites `/api/*` (build-time on Vercel). Required there; local `pnpm dev` defaults to http://127.0.0.1:8080.
# Docker Compose sets this to http://api:8080 for the web service.
# INTERVIEW_API_PROXY_ORIGIN=https://YOUR_SERVICE.up.railway.app

# Production API: hide exception details in JSON responses.
# ASPNETCORE_ENVIRONMENT=Production
