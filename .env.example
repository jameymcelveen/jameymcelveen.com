# Copy to `.env` in the repo root. Next.js loads `.env` automatically.
#
#   cp .env.example .env
#

# Anthropic — Bill / Ask Jamey chat (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Optional model override. Default: claude-haiku-4-5 ($1/1M in, $5/1M out; cache reads ~$0.10/1M).
# ANTHROPIC_MODEL=claude-haiku-4-5
#
# Fit Filter uses the same ANTHROPIC_API_KEY with claude-sonnet-4-6.
# Confirm a monthly budget alert exists in the Anthropic console before sharing the lab URL.

# The Board owner refresh. Server-only. Header x-admin-key on POST /api/the-board/refresh.
# BOARD_ADMIN_KEY=

# Neon / Postgres — optional. When set, `pnpm build` runs migrations/*.sql, then events + /dashboard work.
# DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require
# Demo dashboard data: `pnpm run db:seed` (add `--reset` to replace prior seed rows only).
#
# Optional: cap for the dashboard DB size bar (bytes). Default is 536870912 (0.5 GiB, Neon free).
# ANALYTICS_DB_LIMIT_BYTES=536870912
