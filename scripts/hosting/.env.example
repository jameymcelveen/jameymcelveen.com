# Copy to .env (same folder) — 00-ensure-env.sh does this for you.
# scripts/hosting/.env is gitignored; never commit real values.

# --- Optional: Vercel non-interactive / CI ---
# VERCEL_TOKEN=
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=

# --- Values to mirror on Vercel (production / preview) ---
# Required on Vercel: Interview.Api public URL (Railway → service → Settings → Networking). Evaluated at build time.
INTERVIEW_API_PROXY_ORIGIN=https://YOUR_SERVICE.up.railway.app
STATS_API_KEY=generate-a-long-random-string

# --- Values to mirror on Railway (Interview API) ---
# Optional: absolute server URL in OpenAPI (Try it / Scalar). Defaults to same-origin if unset.
# Optional: OpenAPI "Try it" server base if you use Scalar; can match the public site.
# OpenApi__PublicBaseUrl=https://jameymcelveen.com
GEMINI_API_KEY=
# GEMINI_MODEL=
# STATS_API_KEY must match Vercel STATS_API_KEY
# ConnectionStrings__DefaultConnection=Data Source=/app/data/analytics.db
