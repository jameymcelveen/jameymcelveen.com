# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# assets
/assets

# geoip DB copies (generated by scripts/sync-geoip-data.mjs; traced into serverless bundle)
/vendor/geoip-data/

# dependencies
/node_modules
# pnpm only (Vercel/CI use frozen pnpm-lock.yaml; npm creates drift)
package-lock.json

/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# Local SQLite files (do not use backend/data/ — on macOS it hides backend/Data/ migrations)
backend/**/*.db
backend/**/*.db-shm
backend/**/*.db-wal

# misc
.DS_Store
*.pem

# Editor — ignore local state; allow shared team configs
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json

.idea/*
!.idea/codeStyles/
!.idea/inspectionProfiles/
!.idea/runConfigurations/
!.idea/scopes/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!scripts/hosting/.env.example

# Local hosting automation secrets (never commit)
scripts/hosting/.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
