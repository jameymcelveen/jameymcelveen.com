{
  "name": "jameymcelveen.com",
  "version": "1.3.2",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "postinstall": "node scripts/sync-geoip-data.mjs",
    "dev": "next dev --turbopack",
    "build": "node scripts/sync-geoip-data.mjs && node scripts/run-analytics-migration.mjs && next build --webpack",
    "db:migrate": "node scripts/run-analytics-migration.mjs",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "hosting:env": "bash scripts/hosting/00-ensure-env.sh",
    "hosting:vercel": "bash scripts/hosting/10-vercel-bootstrap.sh",
    "hosting:print-env": "bash scripts/hosting/30-print-env-commands.sh"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@vercel/analytics": "^2.0.1",
    "framer-motion": "^12.27.5",
    "geoip-lite": "^2.0.2",
    "lucide-react": "^0.562.0",
    "next": "16.1.4",
    "pg": "^8.20.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "react-simple-maps": "^3.0.0",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/geoip-lite": "^1.4.4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.4",
    "prettier": "^3.8.0",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "yaml": "^2.8.3"
  }
}
